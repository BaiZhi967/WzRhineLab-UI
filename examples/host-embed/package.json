{
  "name": "@wzrhine/example-host-embed",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "M6 example: a WzRhineLab widget embedded into a non-React host page with hostile legacy global CSS.",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 5175",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --host 127.0.0.1 --port 4175 --strictPort",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test"
  },
  "dependencies": {
    "@wzrhine/react": "workspace:*",
    "@wzrhine/tokens": "workspace:*",
    "motion": "12.43.0",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "4.7.0",
    "typescript": "5.9.3",
    "vite": "6.4.4"
  }
}
