{
  "name": "wzrhine-ui-workspace",
  "private": true,
  "version": "0.0.0",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "pnpm --filter @wzrhine/showcase dev",
    "build": "pnpm --filter @wzrhine/showcase build",
    "build:examples": "pnpm --filter ./examples/* build",
    "preview": "pnpm --filter @wzrhine/showcase preview",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r --filter ./packages/* test",
    "test:e2e": "pnpm --filter @wzrhine/showcase test:e2e",
    "test:examples": "pnpm --filter ./examples/* --workspace-concurrency=1 test:e2e",
    "test:examples:all": "pnpm --filter ./examples/* --workspace-concurrency=1 test:e2e:all",
    "test:visual": "pnpm --filter @wzrhine/showcase test:visual",
    "test:visual:update": "pnpm --filter @wzrhine/showcase test:visual:update",
    "check": "pnpm typecheck && pnpm test && pnpm build && pnpm build:examples",
    "test:e2e:all": "pnpm --filter @wzrhine/showcase test:e2e:all",
    "build:packages": "pnpm --filter ./packages/* build",
    "verify:packages": "node scripts/verify-packages.mjs",
    "size:check": "node scripts/size-check.mjs",
    "api:report": "pnpm build:packages && node scripts/api-report.mjs",
    "api:check": "pnpm build:packages && node scripts/api-report.mjs --check",
    "docs:index": "node scripts/docs-index.mjs",
    "docs:check": "node scripts/docs-index.mjs --check",
    "release:check": "pnpm check && pnpm api:check && pnpm docs:check && pnpm license:audit && pnpm verify:packages && pnpm size:check",
    "release:dry": "node scripts/release.mjs 0.3.0",
    "license:audit": "node scripts/license-audit.mjs"
  }
}
