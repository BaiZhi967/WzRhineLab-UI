{
  "name": "@wzrhine/showcase",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit -p tsconfig.json && vite build",
    "build:pages": "tsc --noEmit -p tsconfig.json && vite build --base=/WzRhineLab-UI/",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "preview": "vite preview --host 127.0.0.1 --port 4173 --strictPort",
    "test:e2e": "playwright test --project=chromium",
    "test:e2e:all": "playwright test --project=chromium && playwright test --project=firefox --workers=4 && playwright test --project=webkit --workers=4",
    "test:visual": "playwright test --project=visual",
    "test:visual:update": "playwright test --project=visual --update-snapshots"
  },
  "dependencies": {
    "@base-ui/react": "1.9.0",
    "@wzrhine/agent": "workspace:*",
    "@wzrhine/content": "workspace:*",
    "@wzrhine/patterns": "workspace:*",
    "@wzrhine/react": "workspace:*",
    "@wzrhine/tokens": "workspace:*",
    "lucide-react": "1.48.0",
    "motion": "^14.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.1",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.5.0",
    "@wzrhine/effects": "workspace:*",
    "typescript": "^5.9.0",
    "vite": "^6.3.0"
  }
}
