{
  "name": "@wzrhine/agent-core",
  "version": "0.0.0",
  "license": "MIT",
  "description": "Framework-free Agent UI contracts for WzRhineLab UI: view-model types, the three status axes, status metadata and pure helpers (dedupe, revision guards, diffs, composer tokens, formatting).",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BaiZhi967/WzRhineLab-UI.git",
    "directory": "packages/agent-core"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    },
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts"
  },
  "devDependencies": {
    "@types/node": "24.19.1",
    "typescript": "^5.9.0",
    "vitest": "4.1.11"
  },
  "scripts": {
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "build": "node ../../scripts/build-package.mjs",
    "prepack": "node ../../scripts/build-package.mjs"
  }
}
